[Unit]
Description=Daily harness update check for the supervised agent

[Timer]
Unit=agent-update.service
# Once a day, at 04:00 UK time. The idle gate can only see "between turns", not
# "nobody is using this session", so on an hourly tick a restart could land in
# the middle of the operator's working day. The zone is explicit rather than the
# box's own (the VMs run UTC), so the hour follows the operator through DST.
#
# A "busy" at 04:00 no longer costs a day, which is what the hourly tick used to
# guard against: agent-update-check.sh keeps re-checking inside the run, up to
# AGENT_IDLE_WAIT_SECS, then restarts anyway.
#
# Deliberately no OnBootSec and no Persistent: either would run the check at
# whatever hour the box happened to boot, and a restart minutes after boot is
# exactly the out-of-hours surprise this schedule exists to avoid. A box that
# was down at 04:00 catches up the next night.
OnCalendar=*-*-* 04:00:00 Europe/London
# The fleet shares an upstream; do not have every VM tick at the same instant.
RandomizedDelaySec=5min
AccuracySec=1m

[Install]
WantedBy=timers.target
